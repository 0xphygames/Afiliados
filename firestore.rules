// Firestore security rules for achadinhos
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin UID placeholder – replace with actual UID
    function isAdmin() {
      return request.auth != null && request.auth.uid == "ADMIN_UID_PLACEHOLDER";
    }
    // Public read for products collection, admin write
    match /produtos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Add other collections as needed
  }
}
