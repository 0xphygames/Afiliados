// Storage security rules for achadinhos
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Admin UID placeholder – replace with actual UID
    function isAdmin() {
      return request.auth != null && request.auth.uid == "ADMIN_UID_PLACEHOLDER";
    }
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
